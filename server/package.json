{
  "name": "vscode-abap-remote-fs-server",
  "displayName": "ABAPfs language server",
  "version": "1.0.0",
  "private": true,
  "description": "Language server for ABAP remote filesystem",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcellourbani/vscode_abap_remote_fs.git"
  },
  "keywords": [
    "ABAP"
  ],
  "author": "Marcello Urbani",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "abap-adt-api": "catalog:",
    "abapcdsgrammar": "0.0.7",
    "antlr4ts": "0.5.0-alpha.4",
    "entities": "catalog:",
    "es-toolkit": "^1.52.0",
    "fast-xml-parser": "catalog:",
    "vscode-abap-remote-fs-sharedapi": "workspace:*",
    "vscode-languageserver": "^6.1.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "scripts": {
    "clean": "node ../scripts/rm.mjs ./out ./dist node_modules",
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --config tsdown.config.ts --watch"
  }
}
