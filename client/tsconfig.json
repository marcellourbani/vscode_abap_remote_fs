{
  "compilerOptions": {
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "ES2021",
    "rootDir": "src",
    "outDir": "out",
    "lib": [
      "es2021"
    ],
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": false,
    "composite": true,
    /* Incremental Compilation */
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "*.d.ts",
    "src/services/testing/runtime/dump-detector.ts",
    "src/services/testing/runtime/sap-session.ts",
    "src/services/testing/runtime/se16n.ts",
    "src/services/testing/runtime/waiters.ts",
    "src/services/testing/runtime/popup-guard.ts",
    "src/services/testing/runtime/sap-artifacts.ts",
    "src/services/testing/runtime/index.ts"
  ]
}