{
  "name": "vscode-abap-remote-fs-client",
  "displayName": "ABAP fs client",
  "description": "Work on your ABAP code straight from the server",
  "version": "0.7.1",
  "publisher": "murbani",
  "license": "MIT",
  "icon": "images/abapfs_logo.png",
  "author": {
    "email": "marcello.urbani@gmail.com",
    "name": "Marcello Urbani"
  },
  "homepage": "https://github.com/marcellourbani/vscode_abap_remote_fs",
  "type": "module",
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcellourbani/vscode_abap_remote_fs.git"
  },
  "keywords": [
    "ABAP",
    "sap",
    "filesystem",
    "remote"
  ],
  "scripts": {
    "vscode:prepublish": "fail",
    "clean": "node ../scripts/rm.mjs out dist node_modules server",
    "build_runtime": "node ../scripts/rm.mjs dist/runtime && tsc -p tsconfig.runtime.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "bundle": "node ../scripts/rm.mjs dist && npm run build_runtime && tsdown --config tsdown.config.ts",
    "test": "vitest run",
    "watch": "npm run build_runtime && concurrently --raw --kill-others \"tsc -p tsconfig.runtime.json --emitDeclarationOnly --watch\" \"tsdown --config tsdown.config.ts --watch\"",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "6.3.0",
    "playwright": "1.61.1",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "5.0.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "dependencies": {
    "@abaplint/core": "^2.102.65",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "abap_cloud_platform": "^1.1.4",
    "abap-adt-api": "^8.4.3",
    "abapfs": "file:../modules/abapfs",
    "abapobject": "file:../modules/abapObject",
    "applicationinsights": "^2.9.8",
    "client-oauth2": "^4.3.3",
    "diff": "^8.0.3",
    "docx": "^9.5.1",
    "entities": "^5.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.2",
    "fp-ts": "^2.13.1",
    "open": "^8.4.0",
    "vscode-abap-remote-fs-sharedapi": "file:../modules/sharedapi",
    "vscode-languageclient": "^9.0.1",
    "vscode-test-adapter-api": "^1.9.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  }
}
