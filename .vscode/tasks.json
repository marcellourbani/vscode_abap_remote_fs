{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "watch abapObject",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/modules/abapObject", "watch"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "watch abapfs",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/modules/abapfs", "watch"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["watch abapObject"]
    },
    {
      "type": "shell",
      "label": "watch sharedapi",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/modules/sharedapi", "watch"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "watch server",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/server", "watch"],
      "problemMatcher": {
        "owner": "tsdown",
        "fileLocation": ["relative", "${workspaceFolder}/server"],
        "pattern": [
          {
            "regexp": "^.*\\[([A-Z0-9_]+)\\]\\s*Error:\\s*(?:\\x1b\\[[0-9;]*m)*\\s*(.+)$",
            "code": 1,
            "message": 2
          },
          {
            "regexp": "^.*\\s((?:[a-zA-Z]:\\\\)?[a-zA-Z0-9_@./\\\\-]+\\.(?:tsx?|jsx?|m?[jt]s)):(\\d+):(\\d+)\\s",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(?:Build start|Starting compilation in watch mode|changed, rebuilding)",
          "endsPattern": "(?:Build complete|Rebuilt|Watching for file changes|at async runCLI)"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["watch sharedapi", "watch abapfs", "typecheck server"]
    },
    {
      "type": "shell",
      "label": "watch client",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/client", "watch"],
      "problemMatcher": {
        "owner": "tsdown",
        "fileLocation": ["relative", "${workspaceFolder}/client"],
        "pattern": [
          {
            "regexp": "^.*\\[([A-Z0-9_]+)\\]\\s*Error:\\s*(?:\\x1b\\[[0-9;]*m)*\\s*(.+)$",
            "code": 1,
            "message": 2
          },
          {
            "regexp": "^.*\\s((?:[a-zA-Z]:\\\\)?[a-zA-Z0-9_@./\\\\-]+\\.(?:tsx?|jsx?|m?[jt]s)):(\\d+):(\\d+)\\s",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(?:Build start|Starting compilation in watch mode|changed, rebuilding)",
          "endsPattern": "(?:Build complete|Rebuilt|Watching for file changes|at async runCLI)"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["watch server", "typecheck client"]
    },
    {
      "type": "shell",
      "label": "typecheck server",
      "command": "pnpm",
      "args": [
        "--dir",
        "${workspaceFolder}/server",
        "exec",
        "tsc",
        "--noEmit",
        "--watch",
        "--preserveWatchOutput"
      ],
      "problemMatcher": {
        "base": "$tsc-watch",
        "owner": "typecheck-server",
        "fileLocation": ["relative", "${workspaceFolder}/server"]
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "typecheck client",
      "command": "pnpm",
      "args": [
        "--dir",
        "${workspaceFolder}/client",
        "exec",
        "tsc",
        "--noEmit",
        "--watch",
        "--preserveWatchOutput"
      ],
      "problemMatcher": {
        "base": "$tsc-watch",
        "owner": "typecheck-client",
        "fileLocation": ["relative", "${workspaceFolder}/client"]
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
