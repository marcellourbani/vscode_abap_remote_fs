{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "watch abapObject",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/modules/abapObject", "watch"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "watch abapfs",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/modules/abapfs", "watch"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["watch abapObject"]
    },
    {
      "type": "shell",
      "label": "watch sharedapi",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/modules/sharedapi", "watch"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "watch server",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/server", "watch"],
      "problemMatcher": {
        "owner": "tsdown",
        "pattern": [{ "regexp": "^\\s*(?:✘|✖|ERROR|error)\\s+(.*)$", "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(?:Build start|Starting compilation in watch mode)",
          "endsPattern": "(?:Build complete|Rebuilt|Watching for file changes)"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["watch sharedapi", "watch abapfs"]
    },
    {
      "type": "shell",
      "label": "watch client",
      "command": "pnpm",
      "args": ["--dir", "${workspaceFolder}/client", "watch"],
      "problemMatcher": {
        "owner": "tsdown",
        "pattern": [{ "regexp": "^\\s*(?:✘|✖|ERROR|error)\\s+(.*)$", "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(?:Build start|Starting compilation in watch mode)",
          "endsPattern": "(?:Build complete|Rebuilt|Watching for file changes)"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["watch server"]
    }
  ]
}
